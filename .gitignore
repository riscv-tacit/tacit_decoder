# Generated by Cargo
# will have compiled files and executables
debug/
target/
target-rust-analyzer/

.vscode/

# These are backup files generated by rustfmt
**/*.rs.bk

*.dump
*.txt
*.afdo
*.log
*.speedscope.json
*.csv
*.png
*.pdf
*.sqlite.db*

# Trace bundles: multi-GB captures assembled by scripts/analysis/bundle_run.py.
# Archived to s3://tacit-trace-bin-bundle/tacit/ -- see bundles/INDEX.md.
bundles/

# Written by scripts/analysis/gen_lua_ncj_configs.py from lua_optab_ncj.json;
# the results dir is passed in, so regenerate rather than commit these.
# lua_ncj_nbody_seq.json is hand-maintained, not generated.
configs/lua/lua_ncj_*.json
!configs/lua/lua_ncj_nbody_seq.json

# Python bytecode
__pycache__/
*.py[cod]
